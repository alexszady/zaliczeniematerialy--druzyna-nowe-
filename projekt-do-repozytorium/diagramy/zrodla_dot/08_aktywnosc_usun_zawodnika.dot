s [label="Start",shape=circle,fillcolor="#DCFCE7"]; choose [label="Wybierz zawodnika"]; confirm [label="Potwierdź usunięcie?",shape=diamond,style=filled,fillcolor="#FEF3C7"]; cancel [label="Anuluj"]; del [label="DELETE /api/players/:id"]; db [label="DELETE z players",shape=cylinder]; refresh [label="Odśwież listę"]; end [label="Koniec",shape=doublecircle,fillcolor="#DCFCE7"];
s -> choose -> confirm; confirm -> cancel [label="Nie"]; cancel -> end; confirm -> del [label="Tak"]; del -> db -> refresh -> end;

